{
  "$schema": "https://claude.com/schemas/hooks.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/carbon-traceability.js",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
