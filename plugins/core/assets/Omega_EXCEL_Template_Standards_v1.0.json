  "exampleUsage": {
    "minimalWorkbook": "const ExcelJS = require('exceljs');\nconst workbook = new ExcelJS.Workbook();\nconst sheet = workbook.addWorksheet('Data');\n\n// Header\nsheet.getCell('A1').value = 'Description';\nsheet.getCell('A1').font = {bold: true};\nsheet.getCell('A1').fill = {type: 'pattern', pattern: 'solid', fgColor: {argb: 'FF104E70'}};\n\n// Data\nsheet.getCell('A2').value = 'Revenue';\nsheet.getCell('B2').value = 1000000;\nsheet.getCell('B2').numFmt = '#,##0';\n\nawait workbook.xlsx.writeFile('output.xlsx');",
    "fullExample": "See: generate_financial_model.js (reference implementation)"
  },

