  "bestPractices": {
    "sheetOrganization": [
      "Cover sheet first",
      "Assumptions sheet second",
      "Data/analysis sheets in logical order",
      "Summary/Dashboard sheet last"
    ],
    "formulaManagement": [
      "Use consistent formula patterns",
      "Document complex formulas with notes",
      "Avoid circular references",
      "Test formulas with edge cases (zero, negative, very large)"
    ],
    "dataIntegrity": [
      "Protect formula cells from accidental editing",
      "Use data validation for input cells",
      "Color-code input vs. calculated cells",
      "Add data validation rules (e.g., positive numbers only)"
    ],
    "usability": [
      "Freeze panes (headers visible when scrolling)",
      "Add hyperlinks for navigation",
      "Include notes/instructions for complex sections",
      "Use descriptive sheet names (no Sheet1, Sheet2)"
    ],
    "performance": [
      "Avoid volatile functions (NOW, TODAY, RAND) in large datasets",
      "Use tables instead of ranges where appropriate",
      "Minimize cross-sheet references where possible",
      "Calculate manually if workbook is very large"
    ]
  },

  "excelJSPatterns": {
    "createWorkbook": "const workbook = new ExcelJS.Workbook();\nworkbook.creator = 'Omega Consulting';\nworkbook.lastModifiedBy = 'Omega';\nworkbook.created = new Date();\nworkbook.modified = new Date();",
    "addWorksheet": "const sheet = workbook.addWorksheet('Sheet Name', {\n  properties: {tabColor: {argb: 'FF1B4F72'}},\n  pageSetup: {paperSize: 9, orientation: 'landscape'}\n});",
    "setCellValue": "sheet.getCell('A1').value = 'Text';\nsheet.getCell('B1').value = 123;\nsheet.getCell('C1').value = {formula: '=B1*2'};",
    "setCellStyle": "sheet.getCell('A1').font = {name: 'Arial', size: 11, bold: true};\nsheet.getCell('A1').fill = {type: 'pattern', pattern: 'solid', fgColor: {argb: 'FF104E70'}};\nsheet.getCell('A1').alignment = {horizontal: 'center', vertical: 'middle'};",
    "setColumnWidth": "sheet.getColumn('A').width = 25;",
    "mergeCells": "sheet.mergeCells('A1:D1');",
    "addBorder": "sheet.getCell('A1').border = {\n  top: {style: 'thin', color: {argb: 'FF9CC2E5'}},\n  left: {style: 'thin', color: {argb: 'FF9CC2E5'}},\n  bottom: {style: 'thin', color: {argb: 'FF9CC2E5'}},\n  right: {style: 'thin', color: {argb: 'FF9CC2E5'}}\n};",
    "saveWorkbook": "await workbook.xlsx.writeFile('output.xlsx');"
  },

