  "numberFormats": {
    "integer": "#,##0",
    "decimal1": "#,##0.0",
    "decimal2": "#,##0.00",
    "currency_egp": "#,##0 \"EGP\"",
    "currency_usd": "\"$\"#,##0",
    "currency_usd_decimal": "\"$\"#,##0.00",
    "percent_0": "0%",
    "percent_1": "0.0%",
    "percent_2": "0.00%",
    "date_short": "dd/mm/yyyy",
    "date_long": "dd mmm yyyy",
    "accounting_egp": "_-#,##0 \"EGP\"_-;-#,##0 \"EGP\"_-;_-\"\" \"EGP\"_-;_-@_-",
    "accounting_usd": "_-\"$\"* #,##0_-;-\"$\"* #,##0_-;_-\"$\"* \"-\"_-;_-@_-"
