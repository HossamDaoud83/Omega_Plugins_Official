    "preGenerationCode": "// MANDATORY PRE-GENERATION VALIDATION\nconst fs = require('fs');\nconst path = require('path');\n\nfunction validateOmegaAssets() {\n  const assetsPath = path.join(__dirname, '../assets');\n  const requiredFiles = [\n    'omega-branding.json',\n    'Omega_EXCEL_Template_Standards_v1.0.json',\n    'BIG3_VISUALIZATION_LIBRARY.json'\n  ];\n  \n  for (const file of requiredFiles) {\n    const filePath = path.join(assetsPath, file);\n    if (!fs.existsSync(filePath)) {\n      throw new Error(`MISSING ASSET: ${file} not found in assets folder`);\n    }\n  }\n  \n  // Load templates\n  const branding = JSON.parse(fs.readFileSync(path.join(assetsPath, 'omega-branding.json')));\n  const excelTemplate = JSON.parse(fs.readFileSync(path.join(assetsPath, 'Omega_EXCEL_Template_Standards_v1.0.json')));\n  \n  console.log('✅ Omega Assets validated - proceeding with generation');\n  return { branding, excelTemplate };\n}\n\n// Call this BEFORE any workbook generation\nconst { branding, excelTemplate } = validateOmegaAssets();",
