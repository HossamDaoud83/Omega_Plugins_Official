  "workbookStructure": {
    "coverSheet": {
      "name": "Cover",
      "purpose": "Workbook title, metadata, navigation",
      "elements": [
        "Workbook title (16pt, Primary, bold, centered)",
        "Project name and reference",
        "Client name",
        "Date and version",
        "Table of contents (hyperlinks to sheets)",
        "Document classification (CONFIDENTIAL)",
        "Prepared by Omega"
      ]
    },
    "assumptionsSheet": {
      "name": "Assumptions",
      "purpose": "Centralized input parameters",
      "sections": [
        "Key Assumptions (growth rates, inflation, etc.)",
        "Financial Parameters (discount rate, tax rate)",
        "Project-Specific Variables",
        "Data Sources & References"
      ],
      "cellTypes": "Mostly input cells (yellow background)"
    },
    "dataSheets": {
      "purpose": "Analysis, calculations, models",
      "naming": "Descriptive names (e.g., 'Enrollment Projections', 'Revenue Model')",
      "structure": [
        "Section header with sheet title",
        "Table headers with column labels",
        "Data rows with calculations",
        "Total/summary rows (bold, double border top)",
        "Notes section at bottom"
      ]
    },
    "summarySheet": {
      "name": "Summary" or "Dashboard",
      "purpose": "Executive summary, key metrics",
      "elements": [
        "Key Performance Indicators (KPIs)",
        "Visual summary (conditional formatting)",
        "Charts and graphs",
        "Links to detailed sheets"
      ]
    }
  },

  "formulaPatterns": {
    "relativeFormula": {
      "description": "Formula that adjusts when copied",
      "example": "=C5*1.25",
      "usage": "Growth calculations, row-by-row operations"
    },
    "absoluteFormula": {
      "description": "Formula with fixed cell references",
      "example": "=$C$5*D10",
      "usage": "References to assumption cells, lookup tables"
    },
    "crossSheetReference": {
      "description": "Reference to cell in another sheet",
      "example": "='Assumptions'!$B$5",
      "usage": "Link to centralized assumptions",
      "bestPractice": "Use absolute references, document row numbers"
    },
    "sumFormula": {
      "description": "Sum range of cells",
      "example": "=SUM(C5:C10)",
      "usage": "Totals, subtotals"
    },
    "roundFormula": {
      "description": "Round to specified decimals",
      "example": "=ROUND(C5*1.25, 0)",
      "usage": "Currency values, clean numbers"
    },
    "ifFormula": {
      "description": "Conditional logic",
      "example": "=IF(C5>0, C5*0.1, 0)",
      "usage": "Conditional calculations, error handling"
    }
  },

  "dataValidation": {
    "beforeGeneration": [
      "List ALL required data fields",
      "Cross-reference against session_state.json or project.json",
      "Identify missing values",
      "ASK USER for missing data - NEVER use placeholders"
    ],
    "formulaIntegrity": [
      "Use hardcoded values from data source for base values",
      "Use relative formulas for growth calculations",
      "Avoid row number references to assumption sheets (they shift)",
      "Test all cross-sheet references",
      "Document exact row numbers for each reference"
    ],
    "afterGeneration": [
      "All cells have values (no blanks where data expected)",
      "All formulas resolve (no #VALUE!, #REF!, #N/A errors)",
      "Cross-sheet references verified",
      "Named ranges avoided (cause issues)",
      "All monetary values from data source, not assumptions"
    ]
  },

